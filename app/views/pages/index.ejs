<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista 1 Exercício 1</title>
</head>
<body>

    <h1>Dia da Semana</h1>
    
    <form action="/classificar" method="post">
        <label for="numero">Digite um número de 1 a 7:</label> <br>
        <input type="text" name="numero" id="numero" value="<%= valores.numero %>"> <br>
        <button type="submit">classificar</button>
     </form>

    <% 
     if(resultado){
        // com dados de retorno
        %>
        <h2>Categoria: <%= resultado.categoria %></h2>
        <%
     }else{
        //sem dados de retorno
        %>
            <h2>Não temos retorno</h2>
        <%
     }
    %>


</body>
</html>